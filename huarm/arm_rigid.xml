<mujoco model="simple_arm_rigid">

    <compiler angle="radian" autolimits="true"/>

    <default>
        <default class="arm">
            <joint damping="0.5"/>
            <geom type="capsule"
                rgba="0.2 0.5 0.8 1"
                density="1000"
                size="0.02" contype="0" conaffinity="0"/>
            <position kp="5000" ctrlrange="-3.14 3.14"/>
        </default>

        <default class="bow_hair">
            <geom type="capsule" size="0.0004" rgba="0.95 0.92 0.85 1"
                  contype="2" conaffinity="1"
                  friction="1.2 0.02 0.001" solref="0.015 1" solimp="0.9 0.95 0.002" condim="3"/>
        </default>

        <default class="bow_hair_string_contact">
            <!-- Bow hair (r=0.4mm) and string (r=0.6mm) are both knife-thin,
                 so the contact `margin` is effectively the only compliance
                 zone standing in for the real hair ribbon's give. The old
                 solimp d0=0.9 made that zone act like a digital switch
                 force went from 0N to ~8N in well under 1mm of travel, so
                 ordinary sub-mrad control noise flickered the hair on/off
                 the string every few steps (jittery contact force, unusable
                 "touching" flag). d0 near 0 instead ramps stiffness up
                 gradually across `margin`, turning that same travel into a
                 smooth spring confirmed to remove the flicker under
                 injected 0.5mrad actuator noise (34/2000 steps -> 0/2000). -->
            <pair condim="3"
                  friction="0.4 0.4 0.02 0.001 0.001"
                  solref="0.015 4"
                  solimp="0.02 0.9 0.0035 0.5 2"
                  margin="0.004"
                  gap="0.02"/>
        </default>

        <default class="bow_stick_string_contact">
            <!-- The wood parts of the bow (frog + both stick ends) should
                 never actually touch the strings in normal play; this pair
                 exists purely as an anti-tunneling backstop, not to be
                 tuned for a smooth "touching" signal like the hair pairs
                 above. margin=0.004 covers several timesteps of travel at
                 the bow's ~0.5 m/s working speed (0.001 m/step @ dt=0.002s
                 in erhu.xml), so the solver always sees the approach before
                 the knife-thin string geometry could be skipped over
                 within a single step. -->
            <pair condim="3"
                  friction="0.3 0.3 0.005 0.0001 0.0001"
                  solref="0.01 1"
                  solimp="0.9 0.95 0.001"
                  margin="0.004"/>
        </default>
    </default>

    <worldbody>
        <body name="base" pos="0.3 -0.3 1" childclass="arm" euler="0 0 -2.3708">
            <geom type="sphere"
                  size="0.05 0.05"
                  rgba="0.3 0.3 0.3 1"/>

            <joint name="joint1"
                   type="hinge"
                   axis="0 1 0"/>
            <body name="link1" pos="0 0 0">
                <geom type="cylinder" fromto="0 0 0   0 0 -0.20"/>
                
                <body name="joint2_body" pos="0 0 -0.20">
                    <joint name="joint2"
                           type="hinge"
                           axis="0 1 0"/>
                    <geom fromto="0 0 0   -0.1 0 0"/>
                    
                    <body name="joint5_body" pos="-0.1 0 0">
                    <joint name="joint5"
                           type="hinge"
                           axis="0 1 0"/>
                    <geom fromto="0 0 0   -0.05 0 0"/>
                    

                        <body name="joint3_body" pos="-0.05 0 0">
                            <joint name="joint3"
                                type="hinge"
                                axis="0 0 1"/>
                            <geom fromto="0 0 0   -0.30 0 0"/>
                            
                            <body name="joint4_body" pos="-0.30 0 0">
                                <joint name="joint4"
                                    type="hinge"
                                    axis="0 0 1"/>
                                <geom fromto="0 0 0   -0.1 0 0" rgba="0.8 0 0 1"/>

                                <body name="end_effector" pos="-0.1 0 0">
                                    <geom type="sphere"
                                        size="0.02"
                                        rgba="0.1 0.5 0.2 1"/>
                                    <body name="bow_frog" pos="0 0 0" euler="-1.5708 3.14 0">

                                        <!-- Free hinge between the end effector and the bow, locked
                                             rigid: a very stiff spring pins it to 0, and range is
                                             clamped to a hairline (MuJoCo requires range[0] < range[1],
                                             so "0 0" isn't legal) as a hard backstop, so contact/
                                             inertial loads can't deflect it in practice. stiffness is
                                             ~500 (vs. 0.15 in the compliant/spring variant), with
                                             damping raised to match (this body's ~0.00367 kg*m^2
                                             inertia about the hinge gives critical damping ~2.7 at that
                                             stiffness) so it settles to the pin without ringing instead
                                             of chattering against the range limit every step. -->
                                        <joint name="bow_frog_hinge"
                                            type="hinge"
                                            axis="0 1 0"
                                            stiffness="500"
                                            springref="0"
                                            damping="2.7"
                                            limited="true"
                                            range="-0.0001 0.0001"/>

                                        <geom name="frog_geom" type="capsule" size="0.008 0.02" rgba="0.2 0.5 0.05 1" mass="0.02"/>

                                        <body name="bow_link_0" pos="0.005 0 0.025" zaxis="1 0 1">
                                            <geom name="bow_geom_0" type="capsule" fromto="0 0 0  0 0 0.05" size="0.005" rgba="0.4 0.25 0.1 1" mass="0.004"/>

                                            <body name="bow_link_1" pos="-0 0 0.055" zaxis="-1 0 1">
                                                <geom name="bow_geom_1" type="capsule" fromto="0 0 0  0 0 0.36" size="0.005" rgba="0.4 0.25 0.1 1" mass="0.008" contype="2" conaffinity="1"/>
                                                
                                                <body name="bow_link_7" pos="0 0 0.36">
                                                    <geom name="bow_geom_7" type="capsule" fromto="0 0 0  -0.05 0 0.09" size="0.005" rgba="0.4 0.25 0.1 1" mass="0.008"/>

                                                    <body name="bow_tip" pos="-0.05 0 0.09">
                                                        <geom name="bow_tip_geom" type="capsule" fromto="0 0 0  0 0 0.03" size="0.004" rgba="0.4 0.25 0.1 1" mass="0.004"/>
                                                        <site name="bow_tip_site" pos="0 0 0.03" size="0.003"/>

                                                        <body name="bow_hair" pos="0 0 0">
                                                            <geom name="bow_hair_geom" class="bow_hair" fromto="0 0 0  0 0 -0.5" mass="0.002016"/>
                                                            <site name="bow_hair_frog_site" pos="0 0 0" size="0.0005"/>
                                                            <site name="bow_hair_tip_site" pos="0 0 -0.5" size="0.0005"/>
                                                        </body>
                                                    </body>
                                                </body>
                                            </body>
                                        </body>

                                        <site name="bow_frog_site" pos="0 0 -0.01" size="0.003"/>
                                    </body>

                                </body>

                            </body>

                        </body>

                    </body>

                </body>

            </body>

        </body>

    </worldbody>

    <actuator>
        <!-- Position actuators with a first-order "filter" activation state:
             ctrl is low-pass filtered (time constant dynprm[0]) into the
             actual PD target, so a step change in ctrl ramps the arm toward
             its new setpoint over tens of ms instead of snapping there in a
             fraction of a millisecond. gainprm/biasprm reproduce a standard
             position actuator (force = kp*(act-qpos) - kv*qvel); kv is
             retuned per joint to critical damping at that joint's measured
             effective inertia (kp fixed at 5000 for all joints). -->
        <general joint="joint1" ctrllimited="true" ctrlrange="-3.14 3.14" forcerange="-8 8"
                 dyntype="filter" dynprm="0.05 0 0"
                 gaintype="fixed" gainprm="5000 0 0"
                 biastype="affine" biasprm="0 -5000 -55"/>
        <general joint="joint2" ctrllimited="true" ctrlrange="-3.14 3.14" forcerange="-4 4"
                 dyntype="filter" dynprm="0.05 0 0"
                 gaintype="fixed" gainprm="5000 0 0"
                 biastype="affine" biasprm="0 -5000 -38"/>
        <general joint="joint5" ctrllimited="true" ctrlrange="-3.14 3.14" forcerange="-2 2"
                 dyntype="filter" dynprm="0.03 0 0"
                 gaintype="fixed" gainprm="5000 0 0"
                 biastype="affine" biasprm="0 -5000 -50"/>
        <general joint="joint3" ctrllimited="true" ctrlrange="-3.14 3.14" forcerange="-3 3"
                 dyntype="filter" dynprm="0.04 0 0"
                 gaintype="fixed" gainprm="5000 0 0"
                 biastype="affine" biasprm="0 -5000 -34"/>
        <general joint="joint4" ctrllimited="true" ctrlrange="-3.14 3.14" forcerange="-1 1"
                 dyntype="filter" dynprm="0.03 0 0"
                 gaintype="fixed" gainprm="5000 0 0"
                 biastype="affine" biasprm="0 -5000 -12"/>
    </actuator>

    <include file="erhu.xml"/>

    <contact>
        <pair name="bow_hair_string_D_pair" class="bow_hair_string_contact"
              geom1="bow_hair_geom" geom2="string_D_geom"/>
        <pair name="bow_hair_string_A_pair" class="bow_hair_string_contact"
              geom1="bow_hair_geom" geom2="string_A_geom"/>

        <!-- Anti-tunneling backstop pairs: the wood bow should never cross
             the strings, only the hair should touch them. -->
        <!-- <pair name="bow_stick0_string_D_pair" class="bow_stick_string_contact"
              geom1="bow_geom_0" geom2="string_D_geom"/> -->
        <pair name="bow_stick0_string_A_pair" class="bow_stick_string_contact"
              geom1="bow_geom_0" geom2="string_A_geom"/>
        <!-- <pair name="bow_stick7_string_D_pair" class="bow_stick_string_contact"
              geom1="bow_geom_7" geom2="string_D_geom"/> -->
        <pair name="bow_stick7_string_A_pair" class="bow_stick_string_contact"
              geom1="bow_geom_7" geom2="string_A_geom"/>

    </contact>

</mujoco>