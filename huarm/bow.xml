<mujoco model="bow">
    <default>
        <default class="bow_link">
            <joint stiffness="15" springref="0" damping="0.1"/>
        </default>

        <!-- Replaces the old flexcomp "cable" plugin (bend/twist elasticity)
             with a discretized rigid-body analogue: each of the 36 hair
             segments is a tiny rigid capsule, and consecutive segments are
             joined by a 3-DOF "universal + twist" hinge stack (two bend
             axes perpendicular to the hair, one twist axis along it), each
             carrying its own torsional spring. This is the same
             stiffness/springref/damping discretization trick already used
             for the bow stick above (class="bow_link"), just applied at a
             finer pitch (36 links of ~1.55 cm instead of 8 of ~9 cm) and
             with an extra twist DOF to stand in for the plugin's "twist"
             elasticity term. The starting stiffness/damping values below
             are a reasonable first guess for "stiff, lightly-damped hair"
             — tune them (and mass/radius) to match the frequency response
             / floppiness you actually want; there's no exact unit-for-unit
             conversion from the old plugin's "bend"/"twist" moduli. -->
        <default class="bow_hair">
            <joint stiffness="0.03" springref="0" damping="0.0005"/>
            <geom type="capsule" size="0.00025" rgba="0.95 0.92 0.85 1"
                  contype="2" conaffinity="1"
                  friction="1.2 0.02 0.001" solref="0.001 1" solimp="0.9 0.99 0.0005" condim="3"/>
        </default>
    </default>
        <!-- ============================== BOW ================================ -->
        <!-- Rigid-body chain of 8 capsule links with hinge joints + torsional
                 springs (stiffness/springref) approximating a continuously
                 bendable bow stick, held under camber by the hair tension. -->
        <!-- ================== BOW FROG / STICK CHAIN ==========================
             The bow_frog body (and the whole capsule-hinge chain hanging off
             it) is no longer a free-floating body here. It has been moved
             into arm.xml, nested inside the arm's "end_effector" body, so
             that the arm physically holds the bow via a compliant ("rubber")
             hinge joint (see arm.xml for "bow_frog_hinge"). This also means
             the old mocap "bow_target" + "teleop_coupling" weld used to
             teleoperate the frog directly are no longer needed (the arm is
             now what moves the bow) and have been removed. -->
        <worldbody>
            <!-- ============================ BOW HAIR ============================== -->
            <!-- Rigid-body replacement for the old 1-D flexcomp "cable" strung
                 between the frog and the tip. Instead of a deformable flex
                 element, this is now a serial chain of 36 rigid capsule
                 bodies (bow_hair_0 ... bow_hair_35, same names/count as the
                 flexcomp's auto-generated nodes so the "hair_to_frog" /
                 "hair_to_tip" equality constraints in erhu.xml still work
                 unmodified) linked by spring-loaded hinges (see class
                 "bow_hair" above). bow_hair_0 gets its own free joint (like
                 an unpinned flex node) since its only other connection to
                 the world is the "hair_to_frog" equality weld; the rest of
                 the chain hangs off it through the hinge stack. Near-
                 inextensibility (previously the flex "edge" equality /
                 solref/solimp) now falls out for free from the links being
                 rigid, so no separate axial constraint is needed. Contact
                 friction/solref/solimp are carried on each geom instead of
                 a flex-wide <contact> block; contype/conaffinity are set so
                 hair segments don't collide with each other (as
                 "selfcollide=none" did) but still collide with everything
                 else (e.g. the strings). -->
            <body name="bow_hair_0" pos="0.575 0 0.645">
                <joint name="bow_hair_0_free" type="free"/>
                <geom name="bow_hair_geom_0" class="bow_hair" fromto="0 0 0  0.0155 0 0" mass="0.000056"/>
                <body name="bow_hair_1" pos="0.0155 0 0">
                    <joint name="bow_hair_1_bend_y" type="hinge" axis="0 1 0" class="bow_hair"/>
                    <joint name="bow_hair_1_bend_z" type="hinge" axis="0 0 1" class="bow_hair"/>
                    <joint name="bow_hair_1_twist_x" type="hinge" axis="1 0 0" class="bow_hair"/>
