<mujoco model="bow">
    <default>
        <default class="bow_link">
            <joint stiffness="15" springref="0" damping="0.1"/>
        </default>

        <!-- Bow hair, take 2: a SINGLE rigid capsule body instead of the
             36-link hinge-chain discretization (which itself replaced the
             original flexcomp "cable"). There is no internal bend/twist DOF
             left at all: the body cannot flex along its own length.
             "Softness" now lives entirely at its two attachment points: the
             body hangs on a free joint (so it has 6 unconstrained DOF of its
             own) and is held in place only by the "hair_to_frog" /
             "hair_to_tip" <connect> equality constraints in erhu.xml. Those
             constraints are what needs to feel spring-like now (previously
             the many hinge springs distributed along the chain gave you a
             floppy, bending strand; here the whole rigidness is
             concentrated in one body). Use a compliant solref/solimp on
             those two equality constraints, something like
             solref="0.01 1" solimp="0.9 0.95 0.001" (numbers to tune) is
             a reasonable starting point instead of MuJoCo's stiff default
             so they behave like two soft springs pulling a rigid rod
             taut, rather than a hard pin. mass/friction below are otherwise
             carried over unchanged from the per-segment version. -->
        <default class="bow_hair">
            <geom type="capsule" size="0.00025" rgba="0.95 0.92 0.85 1"
                  contype="2" conaffinity="1"
                  friction="1.2 0.02 0.001" solref="0.001 1" solimp="0.9 0.99 0.0005" condim="3"/>
        </default>
    </default>
        <!-- ============================== BOW ================================ -->
        <!-- Rigid-body chain of 8 capsule links with hinge joints + torsional
                 springs (stiffness/springref) approximating a continuously
                 bendable bow stick, held under camber by the hair tension. -->
        <!-- ================== BOW FROG / STICK CHAIN ==========================
             The bow_frog body (and the whole capsule-hinge chain hanging off
             it) is no longer a free-floating body here. It has been moved
             into arm.xml, nested inside the arm's "end_effector" body, so
             that the arm physically holds the bow via a compliant ("rubber")
             hinge joint (see arm.xml for "bow_frog_hinge"). This also means
             the old mocap "bow_target" + "teleop_coupling" weld used to
             teleoperate the frog directly are no longer needed (the arm is
             now what moves the bow) and have been removed. -->
        <worldbody>
            <!-- ============================ BOW HAIR ============================== -->
            <!-- Single rigid-body replacement for the old 36-link hinge chain
                 (which itself replaced the original flexcomp "cable" strung
                 between the frog and the tip). This is now ONE capsule body,
                 "bow_hair", spanning the full former chain length
                 (36 * 0.0155 m = 0.558 m) with the combined mass of all 36
                 segments (36 * 0.000056 kg = 0.002016 kg). It carries a free
                 joint (same role as bow_hair_0's old free joint), so it is
                 an independent 6-DOF body positioned entirely by the
                 "hair_to_frog" / "hair_to_tip" equality constraints in
                 erhu.xml (still assumed to exist there; see the note above
                 on making those two constraints compliant, which is now the
                 ONLY source of "give" in the hair since there are no more
                 interior hinges). Two sites mark the two ends
                 ("bow_hair_frog_site" at the near/frog end, local origin;
                 "bow_hair_tip_site" at the far/tip end, local x=0.558) for
                 those equality constraints to anchor to. NOTE: erhu.xml's
                 hair_to_frog/hair_to_tip <connect> elements must be updated
                 to reference body="bow_hair" (both now point at the SAME
                 body, just different anchor points) instead of the old
                 bow_hair_0 / bow_hair_35 body names; that file was not
                 provided alongside bow.xml/arm.xml so it could not be
                 edited here. contype/conaffinity/friction/solref/solimp are
                 carried over unchanged from the per-segment geoms. -->
            <body name="bow_hair" pos="0.575 0 0.645">
                <joint name="bow_hair_free" type="free" damping="0.0001"/>
                <geom name="bow_hair_geom" class="bow_hair" fromto="0 0 0  0.558 0 0" mass="0.002016"/>
                <site name="bow_hair_frog_site" pos="0 0 0" size="0.0005"/>
                <site name="bow_hair_tip_site" pos="0.558 0 0" size="0.0005"/>
            </body>
        </worldbody>
    </mujoco>